{
	"name": "f1_load_to_bronze_master",
	"properties": {
		"activities": [
			{
				"name": "config_lkup",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "load_seasons_silver",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureDatabricksDeltaLakeSource",
						"query": "select * from audit.job_config where endpoint!='seasons'"
					},
					"dataset": {
						"referenceName": "config",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "ForEach_Source_Endpoint",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "config_lkup",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('config_lkup').output.value",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "Check Load Type",
							"type": "IfCondition",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@equals(item().LOAD_TYPE,'FULL')",
									"type": "Expression"
								},
								"ifFalseActivities": [
									{
										"name": "load_to_bronze_inc",
										"type": "ExecutePipeline",
										"dependsOn": [],
										"policy": {
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"pipeline": {
												"referenceName": "f1_load_to_bronze_incremental",
												"type": "PipelineReference"
											},
											"waitOnCompletion": true,
											"parameters": {
												"SOURCE": {
													"value": "@item().SOURCE",
													"type": "Expression"
												},
												"ENDPOINT": {
													"value": "@item().ENDPOINT",
													"type": "Expression"
												},
												"SEASON": {
													"value": "@item().SEASON",
													"type": "Expression"
												},
												"LOAD_TYPE": {
													"value": "@item().LOAD_TYPE",
													"type": "Expression"
												},
												"TARGET": {
													"value": "@item().TARGET",
													"type": "Expression"
												}
											}
										}
									}
								],
								"ifTrueActivities": [
									{
										"name": "load to bronze full",
										"type": "ExecutePipeline",
										"dependsOn": [],
										"policy": {
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"pipeline": {
												"referenceName": "f1_load_to_bronze_full",
												"type": "PipelineReference"
											},
											"waitOnCompletion": true,
											"parameters": {
												"SOURCE": {
													"value": "@item().SOURCE",
													"type": "Expression"
												},
												"ENDPOINT": {
													"value": "@item().ENDPOINT",
													"type": "Expression"
												},
												"SEASON": {
													"value": "@item().SEASON",
													"type": "Expression"
												},
												"LOAD_TYPE": {
													"value": "@item().LOAD_TYPE",
													"type": "Expression"
												},
												"TARGET": {
													"value": "@item().TARGET",
													"type": "Expression"
												}
											}
										}
									}
								]
							}
						}
					]
				}
			},
			{
				"name": "load_seasons_silver",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "load_seasons_bronze",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "f1_load_seasons_to_silver",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true
				}
			},
			{
				"name": "load_seasons_bronze",
				"type": "ExecutePipeline",
				"dependsOn": [],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "f1_load_seasons_to_bronze",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true
				}
			}
		],
		"annotations": []
	}
}